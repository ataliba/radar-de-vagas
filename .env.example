# Copie pra .env (gitignored) e preencha.
# URL da sua instância do JobSync (github.com/Gsync/jobsync) e o token de
# acesso MCP gerado em Settings > MCP Access (com scope jobs:write).
JOBSYNC_URL=http://localhost:3737
JOBSYNC_TOKEN=

# Usuário/senha do dashboard (Basic Auth). Vazio = app aberto, sem login
# (dev local). Preencha as duas antes de subir em produção — o scraper usa
# as mesmas credenciais pra falar com o Rails (ver docker-compose.yml).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Só pro docker-compose.yml (deploy com imagem pronta, via build.sh).
# RAILS_MASTER_KEY = conteúdo de rails/config/master.key (decripta
# credentials.yml.enc — sem isso o Rails não sobe em produção).
RAILS_MASTER_KEY=

# Senha do Postgres interno (serviço "db" do docker-compose.yml). Já tem um
# Postgres externo? Defina DATABASE_URL abaixo em vez disso (sobrescreve o
# default que aponta pro "db") e pode remover o serviço — só se já souber
# o que tá fazendo.
POSTGRES_PASSWORD=
DATABASE_URL=

# Registry/tag da imagem — build.sh sempre publica vX.Y.Z + latest.
# Pra fixar uma versão específica: TAG=0.2.3 docker compose up -d
REGISTRY=docker.io/cybernetus
TAG=latest
