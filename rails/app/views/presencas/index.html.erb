<% content_for :title, "presença por empresa · radar de vagas" %>

<%= render "shared/header", subtitle: "Empresas da sua lista com página na Gupy, InHire e/ou Sólides" %>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Empresa</th>
        <th>Gupy</th>
        <th>InHire</th>
        <th>Vagas InHire</th>
        <th>Sólides</th>
        <th>Vagas Sólides</th>
      </tr>
    </thead>
    <tbody>
      <% @presencas.each do |p| %>
        <tr>
          <td class="empresa"><%= p.empresa %></td>
          <td>
            <% if p.gupy == "Sim" %>
              <%= link_to "Sim", p.gupy_url, target: "_blank", rel: "noopener", class: "badge-sim" %>
            <% else %>
              <span class="mono">—</span>
            <% end %>
          </td>
          <td>
            <% if p.inhire == "Sim" %>
              <%= link_to "Sim", p.inhire_url, target: "_blank", rel: "noopener", class: "badge-sim" %>
            <% else %>
              <span class="mono">—</span>
            <% end %>
          </td>
          <td class="mono"><%= p.inhire_vagas_total %></td>
          <td>
            <% if p.solides == "Sim" %>
              <span class="badge-sim">Sim</span>
            <% else %>
              <span class="mono">—</span>
            <% end %>
          </td>
          <td class="mono"><%= p.solides_vagas %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="pagy-nav">
  <%== pagy_nav(@pagy) %>
</div>
